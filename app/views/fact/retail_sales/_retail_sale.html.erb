<div id="<%= dom_id retail_sale %>">
  <p>
    <strong>Date:</strong>
    <%= retail_sale.date %>
  </p>

  <p>
    <strong>Dimension product:</strong>
    <%= retail_sale.dimension_product_id %>
  </p>

  <p>
    <strong>Dimension store:</strong>
    <%= retail_sale.dimension_store_id %>
  </p>

  <p>
    <strong>Pos transaction number:</strong>
    <%= retail_sale.pos_transaction_number %>
  </p>

  <p>
    <strong>Sales quantity:</strong>
    <%= retail_sale.sales_quantity %>
  </p>

  <p>
    <strong>Regular unit price:</strong>
    <%= retail_sale.regular_unit_price %>
  </p>

  <p>
    <strong>Discount unit price:</strong>
    <%= retail_sale.discount_unit_price %>
  </p>

  <p>
    <strong>Net unit price:</strong>
    <%= retail_sale.net_unit_price %>
  </p>

  <p>
    <strong>Extended discount dollar amount:</strong>
    <%= retail_sale.extended_discount_dollar_amount %>
  </p>

  <p>
    <strong>Extended sales dollar amount:</strong>
    <%= retail_sale.extended_sales_dollar_amount %>
  </p>

  <p>
    <strong>Extended cost dollar amount:</strong>
    <%= retail_sale.extended_cost_dollar_amount %>
  </p>

  <p>
    <strong>Extended gross profit dollar amount:</strong>
    <%= retail_sale.extended_gross_profit_dollar_amount %>
  </p>

</div>
