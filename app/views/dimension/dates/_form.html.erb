<%= form_with(model: dimension_date) do |form| %>
  <% if dimension_date.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(dimension_date.errors.count, "error") %> prohibited this dimension_date from being saved:</h2>

      <ul>
        <% dimension_date.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :calendar_week_number, style: "display: block" %>
    <%= form.number_field :calendar_week_number %>
  </div>

  <div>
    <%= form.label :date, style: "display: block" %>
    <%= form.date_field :date %>
  </div>

  <div>
    <%= form.label :day_of_week, style: "display: block" %>
    <%= form.text_field :day_of_week %>
  </div>

  <div>
    <%= form.label :days_in_month, style: "display: block" %>
    <%= form.number_field :days_in_month %>
  </div>

  <div>
    <%= form.label :full_description, style: "display: block" %>
    <%= form.text_field :full_description %>
  </div>

  <div>
    <%= form.label :month, style: "display: block" %>
    <%= form.number_field :month %>
  </div>

  <div>
    <%= form.label :month_name, style: "display: block" %>
    <%= form.text_field :month_name %>
  </div>

  <div>
    <%= form.label :quarter, style: "display: block" %>
    <%= form.number_field :quarter %>
  </div>

  <div>
    <%= form.label :week_number, style: "display: block" %>
    <%= form.number_field :week_number %>
  </div>

  <div>
    <%= form.label :weeks_in_month, style: "display: block" %>
    <%= form.text_field :weeks_in_month %>
  </div>

  <div>
    <%= form.label :year, style: "display: block" %>
    <%= form.text_field :year %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
