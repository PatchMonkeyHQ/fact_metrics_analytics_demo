<div id="<%= dom_id date %>">
  <p>
    <strong>Calendar week number:</strong>
    <%= date.calendar_week_number %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= date.date %>
  </p>

  <p>
    <strong>Day of week:</strong>
    <%= date.day_of_week %>
  </p>

  <p>
    <strong>Days in month:</strong>
    <%= date.days_in_month %>
  </p>

  <p>
    <strong>Full description:</strong>
    <%= date.full_description %>
  </p>

  <p>
    <strong>Month:</strong>
    <%= date.month %>
  </p>

  <p>
    <strong>Month name:</strong>
    <%= date.month_name %>
  </p>

  <p>
    <strong>Quarter:</strong>
    <%= date.quarter %>
  </p>

  <p>
    <strong>Week number:</strong>
    <%= date.week_number %>
  </p>

  <p>
    <strong>Weeks in month:</strong>
    <%= date.weeks_in_month %>
  </p>

  <p>
    <strong>Year:</strong>
    <%= date.year %>
  </p>

</div>
