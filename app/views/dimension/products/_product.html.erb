<div id="<%= dom_id product %>">
  <p>
    <strong>Product description:</strong>
    <%= product.product_description %>
  </p>

  <p>
    <strong>Brand description:</strong>
    <%= product.brand_description %>
  </p>

  <p>
    <strong>Subcategory description:</strong>
    <%= product.subcategory_description %>
  </p>

  <p>
    <strong>Category description:</strong>
    <%= product.category_description %>
  </p>

  <p>
    <strong>Department description:</strong>
    <%= product.department_description %>
  </p>

  <p>
    <strong>Fat content:</strong>
    <%= product.fat_content %>
  </p>

</div>
